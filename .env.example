# ArticleTrace configuration — copy to .env and fill in.
# .env is gitignored. Never commit real credentials: this repository's history
# was rewritten once to remove a committed .env (devlog/BUG_LOG.md).

# ── Neo4j: holds the knowledge graph AND the vector index ────────────────────
# A free Neo4j Aura instance is sufficient. Note that Aura's free tier deletes
# instances after ~30 days idle — see devlog/BUG_LOG.md DL-025 and the
# backup/restore scripts in knowledge_engine/scripts/10_ and 11_.
# Use neo4j+ssc:// instead of neo4j+s:// if you hit certificate errors.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Google AI Studio: query embeddings + narrative generation ────────────────
# https://aistudio.google.com/  — both names are read; keep them identical.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Orchestrator datastores ──────────────────────────────────────────────────
# Postgres stores scan records. Default assumes a local instance and a
# database named compliance_agent (createdb compliance_agent).
DATABASE_URL=postgresql://localhost:5432/compliance_agent

# Redis is an optional fail-open cache; the service degrades gracefully
# without it and reports "degraded" on /health.
REDIS_URL=redis://localhost:6379/0

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8004
